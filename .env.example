MT5_TERMINAL_PATH=C:\path\to\terminal64.exe
MT5_EXPECTED_LOGIN=12345678
MT5_EXPECTED_SERVER=Your-Demo-Server
MT5_REFRESH_INTERVAL=5
FUND_ID=example-fund
SOURCE_ID=example-source
COLLECTOR_DB_PATH=C:\path\to\collector.sqlite3

# History is opt-in. Choose the real UTC start locally before enabling it.
HISTORY_ENABLED=false
# HISTORY_START_UTC=2026-01-01T00:00:00Z
# HISTORY_CHUNK_SECONDS=86400
# HISTORY_OVERLAP_SECONDS=300
# HISTORY_LOOKBACK_SECONDS=86400
# HISTORY_REFRESH_SECONDS=60
# HISTORY_SLOT_SECONDS=30
# HISTORY_RETRY_SECONDS=30
# HISTORY_RETRY_MAX_SECONDS=300
# HISTORY_SAFETY_LAG_SECONDS=10
# HISTORY_SLOW_SECONDS=1
# HISTORY_SLOW_LIMIT=3
# HISTORY_MIN_CHUNK_SECONDS=300
# HISTORY_MAX_RECORDS=10000

# Reports use IANA Asia/Tehran, independently of the Windows local timezone.
# Broker event/query mapping remains unverified by default. The offline
# inspector accepts --time-mapping C:\private\time-mapping.local.json only
# after the relevant event/query semantics and validity period are verified.
